---
layout: layouts/base.njk
title: "Todos los artículos"
description: Artículos de Barefoot Opiniones organizados por páginas.
pagination:
  data: collections.importedPostsAfterFirstPage
  size: 24
  alias: pagedPosts
permalink: "/articulos/pagina/{{ pagination.pageNumber + 2 }}/"
pageClass: lovable-archive
---
<section class="lov-page-hero"><div class="lov-page-hero__inner">
  <p class="eyebrow">Todos los artículos · Página {{ pagination.pageNumber + 2 }}</p>
  <h1>Todos los artículos</h1>
  <p>{{ collections.importedPosts.length }} artículos publicados en Barefoot Opiniones.</p>
</div></section>
<section class="lov-archive">
  <ul class="lov-archive-list">
    {% for post in pagedPosts %}
      <li class="lov-archive-row"><a href="{{ post.url }}">
        <div class="lov-archive-row__image">{% if (post | featuredImage) %}<img src="{{ (post | featuredImage) }}" alt="{{ (post | featuredImageAlt) or post.data.title }}" loading="lazy">{% endif %}</div>
        <div><h2>{{ post.data.title }}</h2>{% if post.data.description %}<p>{{ post.data.description }}</p>{% endif %}</div>
        <time datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate }}</time>
      </a></li>
    {% endfor %}
  </ul>
  <nav class="pagination-nav" aria-label="Paginación de artículos">
    <a href="{% if pagination.href.previous %}{{ pagination.href.previous }}{% else %}/articulos/{% endif %}">Anterior</a>
    {% for pageNumber in collections.importedPosts.length | pageNumbers(24) %}
      <a href="{{ pageNumber | articlePageUrl }}"{% if pageNumber == pagination.pageNumber + 2 %} aria-current="page"{% endif %}>{{ pageNumber }}</a>
    {% endfor %}
    {% if pagination.href.next %}<a href="{{ pagination.href.next }}">Siguiente</a>{% else %}<span>Siguiente</span>{% endif %}
  </nav>
</section>
