<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {% set pageTitle = title or site.name %}
    {% set seoPageTitle = pageTitle | seoTitle(site.name, page.url) %}
    {% set metaDescription = description | seoDescription(site.description) %}
    <title>{{ seoPageTitle }}</title>
    <meta name="description" content="{{ metaDescription }}">
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">
    {% set pageModelMedia = modelImageAssignments[sourceSlug] %}
    {% set metaImage = pageModelMedia.featured.src if pageModelMedia and pageModelMedia.featured else image or site.heroImage %}
    <meta property="og:type" content="{% if contentType == 'Artículo' %}article{% else %}website{% endif %}">
    <meta property="og:title" content="{{ seoPageTitle }}">
    <meta property="og:description" content="{{ metaDescription }}">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    <meta property="og:site_name" content="{{ site.name }}">
    <meta property="og:locale" content="es_ES">
    {% if contentType == 'Artículo' %}
      <meta property="article:author" content="{{ site.author }}">
      {% set publishedIso = date | htmlDateString %}
      {% if publishedIso %}<meta property="article:published_time" content="{{ publishedIso }}">{% endif %}
      {% if sourceModified %}<meta property="article:modified_time" content="{{ sourceModified }}">{% endif %}
    {% endif %}
    <meta name="author" content="{{ site.author }}">
    <meta name="twitter:title" content="{{ seoPageTitle }}">
    <meta name="twitter:description" content="{{ metaDescription }}">
    {% if metaImage %}
      <meta property="og:image" content="{{ site.url }}{{ metaImage }}">
      <meta name="twitter:card" content="summary_large_image">
      <meta name="twitter:image" content="{{ site.url }}{{ metaImage }}">
    {% endif %}
    <script type="application/ld+json">{% schemaGraph page, site, pageTitle, metaDescription, metaImage, contentType, date, sourceModified, content, pageClass, aggregateRating, reviewedItem, faqItems %}</script>
    <link rel="icon" href="/assets/brand/barefoot-opiniones-mark.svg" type="image/svg+xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&amp;display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/assets/css/styles.css">
  <link rel="stylesheet" href="/assets/css/lovable.css?v=20260715-brand-images">
  </head>
  <body{% if pageClass %} class="{{ pageClass }}"{% endif %}>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="brand" href="/" aria-label="{{ site.name }}">
          <img class="brand-logo" src="/assets/brand/barefoot-opiniones-logo.svg" alt="{{ site.name }}" width="210" height="58">
        </a>
        <nav class="main-nav" aria-label="Principal">
          {% for item in site.nav %}
            <a href="{{ item.url }}" {% if page.url == item.url %}aria-current="page"{% endif %}>{{ item.label }}</a>
          {% endfor %}
        </nav>
      </div>
    </header>

    <main id="contenido">
      {{ content | safe }}
    </main>

    <footer class="site-footer">
      <div class="site-footer__brand">
        <p class="footer-title">{{ site.name }}</p>
        <p>Opiniones honestas de calzado barefoot en español. Sin postureo, sin patrocinios ocultos.</p>
      </div>
      <div class="footer-column">
        <p class="footer-label">Explorar</p>
        <div class="footer-links">
          <a href="/articulos/">Todos los artículos</a>
          <a href="/opiniones/1/">Opiniones de marcas</a>
          <a href="/ninos/">Niños</a>
          <a href="/recursos/">Primeros pasos</a>
        </div>
      </div>
      <div class="footer-column">
        <p class="footer-label">Legal</p>
        <div class="footer-links legal-links" aria-label="Legal">
          <a href="/sobre-mi/">Sobre mí</a>
          <a href="/contacto/">Contacto</a>
          <a href="/politica-de-privacidad/">Privacidad</a>
          <a href="/condiciones-de-uso/">Condiciones</a>
          <a href="/avisos-legales/">Avisos legales</a>
        </div>
      </div>
      <p class="site-footer__copyright">© 2026 {{ site.name }} · Hecho con cariño para pies libres.</p>
    </footer>
  </body>
</html>
