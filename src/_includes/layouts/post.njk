---
layout: layouts/base.njk
---
{% set isFaqContent = false %}
{% set showToc = autoToc == true %}
<article class="lov-article">
  {% include "partials/article-breadcrumb.njk" %}
  <header class="lov-article-hero">
    <div class="lov-article-heading">
      <p class="lov-article-kicker">{{ category or "Guía" }} · {% if sourceModified %}Actualizado {{ sourceModified | readableDate }}{% else %}{{ page.date | readableDate }}{% endif %}</p>
      <h1>{{ title }}</h1>
      {% if description %}<p>{{ description }}</p>{% endif %}
      <div class="article-author article-author--compact">
        <img src="/assets/images/isabel-author.png" alt="Isabel" width="42" height="42">
        <span><strong>Isabel</strong><small>Autora · Barefoot Opiniones</small></span>
      </div>
    </div>
    {% if image %}<div class="lov-article-image editorial-cover editorial-cover--hero">
      <img src="{{ image }}" alt="{{ imageAlt or title }}" loading="eager" width="1600" height="900">
    </div>{% endif %}
  </header>

  <div class="article-layout{% if not showToc %} article-layout--single{% endif %}">
    <div class="article-body imported-content" data-article-content>
      {% if showToc %}
        <details class="article-toc-mobile">
          <summary>En este artículo</summary>
          <nav data-article-toc-mobile></nav>
        </details>
      {% endif %}
      {{ content | safe }}
      <aside class="article-author-card" aria-label="Sobre la autora">
        <img src="/assets/images/isabel-author.png" alt="Isabel" width="56" height="56">
        <div>
          <p>Escrito por Isabel</p>
          <span>Comparo calzado barefoot con una mirada práctica: ajuste, comodidad, materiales y estilo para la vida real.</span>
          <a href="/sobre-mi/">Conoce mi historia</a>
        </div>
      </aside>
    </div>
    {% if showToc %}
      <aside class="article-toc" aria-label="Tabla de contenidos">
        <p>En este artículo</p>
        <nav data-article-toc></nav>
      </aside>
    {% endif %}
  </div>

  {% include "partials/article-footer.njk" %}
</article>
