---
layout: layouts/base.njk
pagination:
  data: localizedArchives
  size: 1
  alias: archive
permalink: "{{ archive.path | localizeUrl }}"
eleventyComputed:
  title: "{{ archive | archiveDisplayTitle }}"
  description: "Explora {{ archive | archiveDisplayTitle }} en Barefoot Opiniones: artículos, opiniones y guías de Isabel para encontrar contenido barefoot por tema, marca o necesidad."
---
{% set archiveItems = collections.importedPosts | archivePosts(archive) %}
{% set archiveLabel = archive | archiveTypeLabel %}
{% set archiveTitle = archive | archiveDisplayTitle %}

<section class="lov-page-hero">
  <div class="lov-page-hero__inner">
      <p class="lov-article-kicker">{{ archiveLabel }} · {{ archiveItems.length }} artículos</p>
      <h1>{{ archiveTitle }}</h1>
      <p>Artículos de BarefootOpiniones agrupados para navegar rápido por tema, intención de búsqueda y tipo de zapato.</p>
  </div>
</section>

<section class="lov-archive">
  {% if archiveItems.length %}
    <div class="lov-category-grid">
      {% for post in archiveItems %}
        <a class="lov-category-card" href="{{ post.url }}">
          <div class="lov-category-card__image editorial-cover editorial-cover--card">
            {% if (post | featuredImage) %}
              <img src="{{ (post | featuredImage) }}" alt="{{ (post | featuredImageAlt) or post.data.title }}" loading="lazy">
            {% endif %}
          </div>
          <div class="lov-category-card__body">
              <time class="lov-card-date" datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate }}</time>
              <h2>{{ post.data.title }}</h2>
              {% if post.data.description %}
                <p>{{ post.data.description | cleanSummary }}</p>
              {% endif %}
          </div>
        </a>
      {% endfor %}
    </div>
  {% else %}
    <section class="taxonomy-empty">
      <p class="eyebrow">Sin resultados claros</p>
      <h2>No he encontrado artículos en esta colección.</h2>
      <p>Puede que esta dirección se conserve por compatibilidad con enlaces antiguos. Puedes volver al directorio completo.</p>
      <a class="button" href="/articulos/">Ver todos los artículos</a>
    </section>
  {% endif %}
</section>
